{
  "name": "sbom-dependency-finder",
  "version": "0.1.0",
  "description": "Trace vulnerable JAR dependencies to their parent Mendix Marketplace widgets/modules",
  "type": "module",
  "bin": {
    "sbom-finder": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mendix",
    "sbom",
    "cyclonedx",
    "dependency",
    "security"
  ],
  "author": "Aidan van Geest <aidan.van.geest@mendix.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.709.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
